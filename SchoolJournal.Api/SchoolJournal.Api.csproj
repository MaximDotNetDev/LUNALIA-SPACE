<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<UserSecretsId>SchoolJournal-Api-Secrets-2026</UserSecretsId>
  </PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SchoolJournal.Application\SchoolJournal.Application.csproj" />
