<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	<DisableIntegrityCheck>true</DisableIntegrityCheck>
	  <NoWarn>$(NoWarn);1591</NoWarn>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\SchoolJournal.Client.Core\SchoolJournal.Client.Core.csproj" />
		<ProjectReference Include="..\..\SchoolJournal.Contracts\SchoolJournal.Contracts.csproj" />
	</ItemGroup>
	
</Project>
