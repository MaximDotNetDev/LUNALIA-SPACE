<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="SpaceBackground">#F8F9FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#5E35B1</Color>
    <Color x:Key="AccentHoverColor">#4527A0</Color>
    <Color x:Key="TextPrimary">#2D3436</Color>
    <Color x:Key="TextSecondary">#636E72</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>

    <SolidColorBrush x:Key="SpaceBackgroundBrush" Color="{StaticResource SpaceBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
</ResourceDictionary>