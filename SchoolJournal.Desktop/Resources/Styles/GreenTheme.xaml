<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SpaceBackground">#c0fac5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#16A34A</Color>
    <Color x:Key="AccentHoverColor">#15803D</Color>
    <Color x:Key="TextPrimary">#064E3B</Color>
    <Color x:Key="TextSecondary">#065F46</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="BorderColor">#BBF7D0</Color>

    <SolidColorBrush x:Key="SpaceBackgroundBrush" Color="{StaticResource SpaceBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
</ResourceDictionary>