<UserControl
    x:Class="SchoolJournal.Desktop.Features.Journal.JournalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gradesView="clr-namespace:SchoolJournal.Desktop.Features.Operations.Grades"
    xmlns:gradesVm="clr-namespace:SchoolJournal.Client.Core.Features.Operations.Grades;assembly=SchoolJournal.Client.Core"
    xmlns:lessonsView="clr-namespace:SchoolJournal.Desktop.Features.Operations.Lessons"
    xmlns:lessonsVm="clr-namespace:SchoolJournal.Client.Core.Features.Operations.Lessons;assembly=SchoolJournal.Client.Core">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type lessonsVm:LessonsViewModel}">
            <lessonsView:LessonsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type gradesVm:GradesViewModel}">
            <gradesView:GradesView />
        </DataTemplate>

        <Style x:Key="JournalTabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Background" Value="#ECF0F1" />
            <Setter Property="Foreground" Value="#2C3E50" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDC3C7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,10,20" Orientation="Vertical">
                <Expander
                    Margin="0,0,0,10"
                    Background="#FAFAFA"
                    FontWeight="Bold"
                    Foreground="#2C3E50"
                    Header="📖 Журнал"
                    IsExpanded="True">
                    <StackPanel Margin="5,5,0,0" Orientation="Vertical">
                        <Button
                            Command="{Binding NavigateToLessonsCommand}"
                            Content="📚 Уроки та Теми"
                            Style="{StaticResource JournalTabButtonStyle}" />

                        <Button
                            Command="{Binding NavigateToGradesCommand}"
                            Content="💯 Оцінки"
                            Style="{StaticResource JournalTabButtonStyle}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Column="1"
            Margin="20"
            Background="White"
            CornerRadius="5">
            <ContentControl Content="{Binding CurrentJournalView}" />
        </Border>
    </Grid>
</UserControl>