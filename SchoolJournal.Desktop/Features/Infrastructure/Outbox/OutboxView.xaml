<UserControl
    x:Class="SchoolJournal.Desktop.Features.Infrastructure.Outbox.OutboxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="Моніторинг Outbox (Черга подій)" />

            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="Тип:" />
                <TextBox
                    Width="150"
                    Margin="0,0,15,0"
                    Text="{Binding FilterType, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    Content="Тільки з помилками"
                    IsChecked="{Binding FilterHasError}" />

                <Button
                    Padding="15,5"
                    Background="#3498DB"
                    Command="{Binding LoadMessagesCommand}"
                    Content="🔍 Оновити"
                    Foreground="White" />

                <Button
                    Margin="20,0,0,0"
                    Padding="10,5"
                    Background="#E67E22"
                    Command="{Binding PurgeOldMessagesCommand}"
                    Content="🧹 Очистити старі (30д)"
                    Foreground="White" />
            </StackPanel>
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Messages}"
            SelectedItem="{Binding SelectedMessage}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding OccurredOnUtc, StringFormat='dd.MM.yyyy HH:mm:ss'}"
                    Header="Дата (UTC)" />
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding Type}"
                    Header="Тип події" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding ProcessedOnUtc, TargetNullValue='⏳ В черзі'}"
                    Header="Статус" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Error}"
                    Header="Помилка">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="2"
            Margin="10"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Margin="5,0"
                Command="{Binding PreviousPageCommand}"
                Content="⬅️" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="{Binding PageNumber, StringFormat='Сторінка {0}'}" />
            <Button
                Margin="5,0"
                Command="{Binding NextPageCommand}"
                Content="➡️" />
        </StackPanel>

        <GroupBox
            Grid.Row="3"
            Margin="0,10,0,0"
            Header="Вміст повідомлення (JSON)">
            <TextBox
                Background="#F8F9F9"
                FontFamily="Consolas"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Text="{Binding SelectedMessage.Content, Mode=OneWay}"
                VerticalScrollBarVisibility="Auto" />
        </GroupBox>

        <ProgressBar
            Grid.Row="1"
            Height="3"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />
    </Grid>
</UserControl>