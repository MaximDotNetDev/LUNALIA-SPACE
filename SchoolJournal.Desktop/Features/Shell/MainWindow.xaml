<Window
    x:Class="SchoolJournal.Desktop.Features.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:logsView="clr-namespace:SchoolJournal.Desktop.Features.Infrastructure.Logs"
    xmlns:logsVm="clr-namespace:SchoolJournal.Client.Core.Features.Infrastructure.Logs;assembly=SchoolJournal.Client.Core"
    xmlns:settingsView="clr-namespace:SchoolJournal.Desktop.Features.Settings"
    xmlns:settingsVm="clr-namespace:SchoolJournal.Client.Core.Features.Settings;assembly=SchoolJournal.Client.Core"
    MinWidth="1100"
    MinHeight="700"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
            <settingsView:SettingsView />
        </DataTemplate>

        <DataTemplate
            xmlns:adminView="clr-namespace:SchoolJournal.Desktop.Features.Administration"
            xmlns:adminVm="clr-namespace:SchoolJournal.Client.Core.Features.Administration;assembly=SchoolJournal.Client.Core"
            DataType="{x:Type adminVm:AdministrationViewModel}">
            <adminView:AdministrationView />
        </DataTemplate>

        <DataTemplate
            xmlns:journalView="clr-namespace:SchoolJournal.Desktop.Features.Journal"
            xmlns:journalVm="clr-namespace:SchoolJournal.Client.Core.Features.Journal;assembly=SchoolJournal.Client.Core"
            DataType="{x:Type journalVm:JournalViewModel}">
            <journalView:JournalView />
        </DataTemplate>

        <DataTemplate
            xmlns:academicsView="clr-namespace:SchoolJournal.Desktop.Features.Academics"
            xmlns:academicsVm="clr-namespace:SchoolJournal.Client.Core.Features.Academics;assembly=SchoolJournal.Client.Core"
            DataType="{x:Type academicsVm:AcademicsViewModel}">
            <academicsView:AcademicsView />
        </DataTemplate>

        <DataTemplate
            xmlns:peopleView="clr-namespace:SchoolJournal.Desktop.Features.People"
            xmlns:peopleVm="clr-namespace:SchoolJournal.Client.Core.Features.People;assembly=SchoolJournal.Client.Core"
            DataType="{x:Type peopleVm:PeopleViewModel}">
            <peopleView:PeopleView />
        </DataTemplate>

        <DataTemplate
            xmlns:scheduleView="clr-namespace:SchoolJournal.Desktop.Features.Schedule"
            xmlns:scheduleVm="clr-namespace:SchoolJournal.Client.Core.Features.Schedule;assembly=SchoolJournal.Client.Core"
            DataType="{x:Type scheduleVm:ScheduleViewModel}">
            <scheduleView:ScheduleView />
        </DataTemplate>

        <DataTemplate
            xmlns:testingView="clr-namespace:SchoolJournal.Desktop.Features.Testing"
            xmlns:testingVm="clr-namespace:SchoolJournal.Client.Core.Features.Testing;assembly=SchoolJournal.Client.Core"
            DataType="{x:Type testingVm:TestingViewModel}">
            <testingView:TestingView />
        </DataTemplate>

        <DataTemplate
            xmlns:announcementsView="clr-namespace:SchoolJournal.Desktop.Features.Communications"
            xmlns:announcementsVm="clr-namespace:SchoolJournal.Client.Core.Features.Communications.Announcements;assembly=SchoolJournal.Client.Core"
            DataType="{x:Type announcementsVm:AnnouncementsViewModel}">
            <announcementsView:AnnouncementsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="190" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggleButton}" Value="False">
                                <Setter Property="Width" Value="65" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Border Style="{DynamicResource SidebarCardStyle}">

                <Grid Margin="0,30,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,30"
                        Style="{DynamicResource LogoTextBlockStyle}"
                        Visibility="{Binding IsChecked, ElementName=SidebarToggleButton, Converter={StaticResource BoolToVis}}">
                        LUNALIA<LineBreak />
                        <Run Style="{DynamicResource LogoRunStyle}">S P A C E</Run>
                    </TextBlock>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsChecked, ElementName=SidebarToggleButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>



                            <Button
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateToTestingCommand}"
                                Content="📝 Завдання"
                                Style="{StaticResource MenuButtonStyle}" />


                            <Button
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateToPeopleCommand}"
                                Content="👨‍👩‍👧‍👦 Контингент"
                                Style="{StaticResource MenuButtonStyle}"
                                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource BoolToVis}}" />

                            <Button
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateToAcademicsCommand}"
                                Content="🏫 Структура"
                                Style="{StaticResource MenuButtonStyle}"
                                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource BoolToVis}}" />

                            <Button
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateToSettingsCommand}"
                                Content="⚙️ Налаштування"
                                Style="{StaticResource MenuButtonStyle}"
                                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource BoolToVis}}" />

                            <Button
                                HorizontalContentAlignment="Left"
                                Command="{Binding NavigateToAdministrationCommand}"
                                Content="🛡️ Адміністрування"
                                Style="{StaticResource MenuButtonStyle}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />

                            <Button
                                HorizontalContentAlignment="Left"
                                Command="{Binding LogoutCommand}"
                                Content="🚪 Вихід"
                                Foreground="{DynamicResource ErrorBrush}"
                                Style="{StaticResource MenuButtonStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Grid.Column="0"
                            Margin="16,10,10,0"
                            ItemsSource="{Binding AvailableThemes}"
                            SelectedItem="{Binding SelectedTheme}"
                            Visibility="{Binding IsChecked, ElementName=SidebarToggleButton, Converter={StaticResource BoolToVis}}" />

                        <ToggleButton
                            x:Name="SidebarToggleButton"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Margin="0,10,16,0"
                            Cursor="Hand"
                            IsChecked="True">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Content" Value="❮" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Content" Value="❯" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Border Style="{DynamicResource ContentCardStyle}">

                <ContentControl Margin="13" Content="{Binding CurrentView}" />
            </Border>
        </Grid>
    </Grid>
</Window>