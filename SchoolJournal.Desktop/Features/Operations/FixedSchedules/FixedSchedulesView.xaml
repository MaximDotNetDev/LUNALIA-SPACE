<UserControl
    x:Class="SchoolJournal.Desktop.Features.Operations.FixedSchedules.FixedSchedulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,15"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="Сталий розклад" />

            <TextBlock
                Margin="20,0,10,0"
                VerticalAlignment="Center"
                Text="День тижня:" />
            <ComboBox
                Width="120"
                VerticalContentAlignment="Center"
                ItemsSource="{Binding DaysOfWeek}"
                SelectedItem="{Binding SelectedDayOfWeek}" />

            <Button
                Margin="20,0,0,0"
                Padding="15,5"
                Background="#2ECC71"
                Command="{Binding OpenCreateFormCommand}"
                Content="➕ Додати урок"
                Foreground="White"
                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource UniversalVis}}" />

            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            BorderBrush="#DDD"
            BorderThickness="1"
            IsReadOnly="True"
            ItemsSource="{Binding Schedules}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding AssignmentDetails}"
                    Header="Дисципліна, Клас та Вчитель" />
                <DataGridTextColumn
                    Width="1.5*"
                    Binding="{Binding PeriodName}"
                    Header="Дзвінок" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding RoomName}"
                    Header="Кабінет" />
                <DataGridTemplateColumn
                    Width="100"
                    Header="Дії"
                    Visibility="{Binding DataContext.IsAdminOrDirector, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource UniversalVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#F39C12"
                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="✏️"
                                    FontSize="12"
                                    Foreground="White" />
                                <Button
                                    Background="#E74C3C"
                                    Command="{Binding DataContext.DeleteScheduleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="Видалити"
                                    FontSize="10"
                                    Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="{Binding IsFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Direction="270"
                        Opacity="0.25"
                        ShadowDepth="2" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="{Binding FormTitle}" />
                    <TextBlock
                        Margin="0,0,0,15"
                        Foreground="Red"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="День тижня (1-7):" />
                    <ComboBox
                        Margin="0,0,0,15"
                        ItemsSource="{Binding DaysOfWeek}"
                        SelectedItem="{Binding FormDayOfWeek}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="ID Призначення (AssignmentId):" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        Text="{Binding FormAssignmentId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="ID Періоду/Дзвінка (PeriodId):" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        Text="{Binding FormPeriodId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="ID Кабінету (RoomId):" />
                    <TextBox
                        Margin="0,0,0,25"
                        Padding="5"
                        Text="{Binding FormRoomId, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseFormCommand}"
                            Content="Скасувати"
                            FontWeight="Bold"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#3498DB"
                            Command="{Binding SaveFormCommand}"
                            Content="Зберегти"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>