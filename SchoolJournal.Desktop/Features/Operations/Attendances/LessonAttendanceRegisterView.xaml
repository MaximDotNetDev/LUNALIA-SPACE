<UserControl
    x:Class="SchoolJournal.Desktop.Features.Operations.Attendances.LessonAttendanceRegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />

        <ObjectDataProvider
            x:Key="AttendanceStatuses"
            MethodName="GetValues"
            ObjectType="{x:Type system:Enum}" />
        <x:Array x:Key="StatusList" Type="system:String">
            <system:String>Present</system:String>
            <system:String>Absent</system:String>
            <system:String>Late</system:String>
            <system:String>Excused</system:String>
        </x:Array>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="Журнал відвідуваності уроку" />
            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="#555"
                    Text="Дата: " />
                <TextBlock
                    Margin="0,0,15,0"
                    Foreground="#333"
                    Text="{Binding LessonDate}" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="#555"
                    Text="Тема: " />
                <TextBlock Foreground="#333" Text="{Binding LessonTopic}" />
            </StackPanel>
            <TextBlock
                Margin="0,10,0,0"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            BorderBrush="#DDD"
            BorderThickness="1"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            ItemsSource="{Binding Students}">
            <DataGrid.Columns>

                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding FullName}"
                    Header="ПІБ Учня"
                    IsReadOnly="True" />

                <DataGridTemplateColumn Width="150" Header="Статус">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                Margin="2"
                                ItemsSource="{StaticResource StatusList}"
                                SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                    Header="Коментар вчителя" />

            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />

        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Padding="20,10"
                Background="#3498DB"
                Command="{Binding SaveBulkAttendancesCommand}"
                Content="💾 Зберегти зміни"
                FontWeight="Bold"
                Foreground="White" />
        </StackPanel>
    </Grid>
</UserControl>