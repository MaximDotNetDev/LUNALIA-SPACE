<UserControl
    x:Class="SchoolJournal.Desktop.Features.Operations.QuizAssignments.QuizAssignmentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource PageHeaderTextStyle}"
            Text="Журнал призначень завдань" />

        <WrapPanel
            Grid.Row="1"
            Margin="0,0,0,15"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Оберіть тест:" />

            <ComboBox
                Width="250"
                Padding="5"
                DisplayMemberPath="Title"
                ItemsSource="{Binding AvailableQuizzes}"
                SelectedValue="{Binding SearchQuizId, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="QuizId" />

            <Button
                Margin="10,0,0,0"
                Command="{Binding LoadAssignmentsByQuizCommand}"
                Content="🔍 Шукати"
                Style="{StaticResource SpaceActionInfoButton}" />

            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </WrapPanel>

        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Assignments}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Style="{StaticResource SpaceDataGridStyle}">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="80"
                    MinWidth="80"
                    Binding="{Binding ClassName}"
                    FontWeight="Bold"
                    Header="Клас" />

                <DataGridTextColumn
                    Width="160"
                    MinWidth="150"
                    Binding="{Binding AssignedDate, StringFormat='dd.MM.yyyy HH:mm'}"
                    Header="Дата призначення" />

                <DataGridTextColumn
                    Width="*"
                    MinWidth="150"
                    Binding="{Binding DueDate, StringFormat='dd.MM.yyyy HH:mm'}"
                    Header="Дедлайн" />

                <DataGridTemplateColumn
                    Width="Auto"
                    MinWidth="380"
                    Header="Дії">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Command="{Binding DataContext.OpenTakeQuizCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="▶️ Пройти"
                                    Style="{StaticResource SpaceActionSuccessButton}" />

                                <Button
                                    Margin="0,0,5,0"
                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="✏️ Ред."
                                    Style="{StaticResource SpaceActionWarningButton}"
                                    ToolTip="Редагувати дедлайн" />

                                <Button
                                    Margin="0,0,5,0"
                                    Command="{Binding DataContext.OpenResultsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="📊 Рез-ти"
                                    Style="{StaticResource SpaceActionInfoButton}"
                                    ToolTip="Переглянути результати" />

                                <Button
                                    Command="{Binding DataContext.DeleteAssignmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="✖ Скасувати"
                                    Style="{StaticResource SpaceActionDangerButton}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar
            Grid.Row="2"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Style="{StaticResource SpaceProgressBarStyle}"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="{Binding IsEditFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="350"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SpacePanelBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SpaceDialogHeaderTextStyle}" Text="Зміна дедлайну" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="Новий термін здачі:" />

                    <DatePicker Margin="0,0,0,25" SelectedDate="{Binding EditDueDate}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Command="{Binding CloseEditFormCommand}"
                            Content="Скасувати"
                            Style="{StaticResource SpaceDialogSecondaryButton}" />

                        <Button
                            Grid.Column="2"
                            Command="{Binding SaveEditFormCommand}"
                            Content="Зберегти"
                            Style="{StaticResource SpaceDialogPrimaryButton}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="105"
            Background="#80000000"
            Visibility="{Binding IsResultsOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="600"
                MaxHeight="500"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SpacePanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource SpaceDialogHeaderTextStyle}"
                        Text="📊 Результати тестування" />

                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding SubmissionResults}"
                        Style="{StaticResource SpaceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding StudentFullName}"
                                FontWeight="Bold"
                                Header="Учень" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Score}"
                                Header="Оцінка" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding MaxScore}"
                                Header="Макс." />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding SubmittedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                Header="Дата здачі" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button
                        Grid.Row="2"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseResultsCommand}"
                        Content="Закрити"
                        Style="{StaticResource SpaceDialogSecondaryButton}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>