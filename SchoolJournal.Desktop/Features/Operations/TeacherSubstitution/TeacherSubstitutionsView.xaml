<UserControl
    x:Class="SchoolJournal.Desktop.Features.Operations.TeacherSubstitution.TeacherSubstitutionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,15"
            Orientation="Horizontal">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="Заміни вчителів (Операційне керування)" />
            <Button
                Margin="20,0,0,0"
                Padding="15,5"
                Background="#2ECC71"
                Command="{Binding OpenCreateFormCommand}"
                Content="➕ Призначити заміну"
                Foreground="White"
                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource UniversalVis}}" />
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            BorderBrush="#DDD"
            BorderThickness="1"
            IsReadOnly="True"
            ItemsSource="{Binding Substitutions}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="1.5*"
                    Binding="{Binding SubstituteTeacherFullName}"
                    Header="Вчитель на заміну" />
                <DataGridTextColumn
                    Width="1.5*"
                    Binding="{Binding MainTeacherFullName}"
                    Header="Основний вчитель" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding SubjectName}"
                    Header="Предмет" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding ClassName}"
                    Header="Клас" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding SubgroupName, TargetNullValue='Весь клас'}"
                    Header="Підгрупа" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding StartDate, StringFormat='dd.MM.yyyy'}"
                    Header="Початок" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding EndDate, StringFormat='dd.MM.yyyy'}"
                    Header="Кінець" />
                <DataGridTemplateColumn
                    Width="150"
                    Header="Дії"
                    Visibility="{Binding DataContext.IsAdminOrDirector, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource UniversalVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Padding="8,2"
                                    Background="#F39C12"
                                    Command="{Binding DataContext.OpenEditFormAsyncCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="✏️ Редагувати"
                                    FontSize="11"
                                    Foreground="White" />
                                <Button
                                    Padding="8,2"
                                    Background="#E74C3C"
                                    Command="{Binding DataContext.DeleteSubstitutionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="Видалити"
                                    FontSize="11"
                                    Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="{Binding IsFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="450"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="{Binding FormTitle}" />
                    <TextBlock
                        Margin="0,0,0,15"
                        Foreground="Red"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="ID Навчального призначення (GUID):" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        Text="{Binding FormAssignmentId, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="ID Вчителя на заміну (GUID):" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        Text="{Binding FormSubstituteTeacherId, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="Дата початку заміни:" />
                    <DatePicker Margin="0,0,0,15" SelectedDate="{Binding FormStartDate}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="Дата закінчення заміни:" />
                    <DatePicker Margin="0,0,0,25" SelectedDate="{Binding FormEndDate}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseFormCommand}"
                            Content="Скасувати"
                            FontWeight="Bold"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#3498DB"
                            Command="{Binding SaveFormCommand}"
                            Content="Зберегти зміни"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>