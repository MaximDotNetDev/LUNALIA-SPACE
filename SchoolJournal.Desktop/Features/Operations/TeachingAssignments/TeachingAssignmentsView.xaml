<UserControl
    x:Class="SchoolJournal.Desktop.Features.Operations.TeachingAssignments.TeachingAssignmentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="Навчальні призначення" />

            <TextBlock
                Margin="20,0,5,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="#555"
                Text="Фільтр по класу:" />

            <ComboBox
                Width="150"
                VerticalAlignment="Center"
                DisplayMemberPath="ClassName"
                ItemsSource="{Binding Classes}"
                SelectedItem="{Binding SelectedFilterClass}" />

            <Button
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding OpenCreateFormCommand}"
                Content="➕ Додати"
                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Assignments}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding TeacherFullName}"
                    Header="Вчитель" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding SubjectName}"
                    Header="Предмет" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding SubgroupName, TargetNullValue='(Увесь клас)'}"
                    Header="Підгрупа" />
                <DataGridCheckBoxColumn
                    Width="80"
                    Binding="{Binding IsActive}"
                    Header="Активно" />
                <DataGridTemplateColumn
                    Width="150"
                    Header="Дії"
                    Visibility="{Binding DataContext.IsAdminOrDirector, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource UniversalVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#3498DB"
                                    Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="Статус"
                                    FontSize="10"
                                    Foreground="White" />
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#F39C12"
                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="✏️"
                                    FontSize="12"
                                    Foreground="White" />
                                <Button
                                    Background="#E74C3C"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="Видалити"
                                    FontSize="10"
                                    Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="{Binding IsFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="450"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="Вчитель:" />
                    <ComboBox
                        Margin="0,0,0,15"
                        Padding="5"
                        ItemsSource="{Binding Teachers}"
                        SelectedValue="{Binding FormTeacherId, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="TeacherId">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="Bold" Text="{Binding LastName}" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding FirstName}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="Предмет:" />
                    <ComboBox
                        Margin="0,0,0,15"
                        Padding="5"
                        DisplayMemberPath="SubjectName"
                        ItemsSource="{Binding Subjects}"
                        SelectedValue="{Binding FormSubjectId, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="SubjectId" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="Клас:" />
                    <ComboBox
                        Margin="0,0,0,15"
                        Padding="5"
                        DisplayMemberPath="ClassName"
                        ItemsSource="{Binding Classes}"
                        SelectedValue="{Binding FormClassId, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="ClassId" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="Підгрупа (опціонально):" />
                    <ComboBox
                        Margin="0,0,0,25"
                        Padding="5"
                        ItemsSource="{Binding Subgroups}"
                        SelectedValue="{Binding FormSubgroupId, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="SubgroupId">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        Foreground="Gray"
                                        Text="{Binding ClassName}" />
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        Foreground="Gray"
                                        Text="—" />
                                    <TextBlock FontWeight="Bold" Text="{Binding SubgroupName}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseFormCommand}"
                            Content="Скасувати"
                            FontWeight="Bold"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#3498DB"
                            Command="{Binding SaveFormCommand}"
                            Content="Зберегти"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>