<UserControl
    x:Class="SchoolJournal.Desktop.Features.Reference.Position.PositionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,15"
            Orientation="Horizontal">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="Керування посадами" />
            <Button
                Margin="20,0,0,0"
                Padding="15,5"
                Background="#2ECC71"
                Command="{Binding OpenCreateFormCommand}"
                Content="➕ Створити посаду"
                Foreground="White" />
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            BorderBrush="#DDD"
            BorderThickness="1"
            IsReadOnly="True"
            ItemsSource="{Binding Positions}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding PositionName}"
                    Header="Назва посади" />
                <DataGridTemplateColumn Width="150" Header="Дії">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Padding="5,2"
                                    Background="#F39C12"
                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="✏️ Редагувати"
                                    FontSize="11"
                                    Foreground="White" />
                                <Button
                                    Padding="5,2"
                                    Background="#E74C3C"
                                    Command="{Binding DataContext.DeletePositionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="Видалити"
                                    FontSize="11"
                                    Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="{Binding IsFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="350"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{Binding FormTitle}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Foreground="Red"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Text="Назва посади:" />
                    <TextBox
                        Margin="0,0,0,25"
                        Padding="5"
                        Text="{Binding FormPositionName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseFormCommand}"
                            Content="Скасувати"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#3498DB"
                            Command="{Binding SaveFormCommand}"
                            Content="Зберегти"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />
    </Grid>
</UserControl>