<UserControl
    x:Class="SchoolJournal.Desktop.Features.Testing.TestingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assignView="clr-namespace:SchoolJournal.Desktop.Features.Operations.QuizAssignments"
    xmlns:assignVm="clr-namespace:SchoolJournal.Client.Core.Features.Operations.QuizAssignments;assembly=SchoolJournal.Client.Core"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:questionsView="clr-namespace:SchoolJournal.Desktop.Features.Operations.QuizQuestions"
    xmlns:questionsVm="clr-namespace:SchoolJournal.Client.Core.Features.Operations.QuizQuestions;assembly=SchoolJournal.Client.Core"
    xmlns:quizzesView="clr-namespace:SchoolJournal.Desktop.Features.Operations.Quizzes"
    xmlns:quizzesVm="clr-namespace:SchoolJournal.Client.Core.Features.Operations.Quizzes;assembly=SchoolJournal.Client.Core"
    xmlns:takeQuizView="clr-namespace:SchoolJournal.Desktop.Features.Operations.QuizExecution"
    xmlns:takeQuizVm="clr-namespace:SchoolJournal.Client.Core.Features.Operations.QuizExecution;assembly=SchoolJournal.Client.Core"
    Background="Transparent"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />

        <DataTemplate DataType="{x:Type quizzesVm:QuizzesViewModel}">
            <quizzesView:QuizzesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type assignVm:QuizAssignmentsViewModel}">
            <assignView:QuizAssignmentsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type assignVm:StudentAssignmentsViewModel}">
            <assignView:StudentAssignmentsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type questionsVm:QuizQuestionsViewModel}">
            <questionsView:QuizQuestionsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type quizzesVm:AiQuizGeneratorViewModel}">
            <quizzesView:AiQuizGeneratorView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type takeQuizVm:TakeQuizViewModel}">
            <takeQuizView:TakeQuizView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10,5,20,5">

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{Binding IsTeacher, Converter={StaticResource BoolToVis}}">
                <Button
                    Margin="5"
                    Command="{Binding NavigateToQuizzesCommand}"
                    Content="📄 Бібліотека завдань"
                    Style="{StaticResource MenuButtonStyle}" />
                <Button
                    Margin="5"
                    Command="{Binding NavigateToQuizAssignmentsCommand}"
                    Content="📋 Журнал призначень"
                    Style="{StaticResource MenuButtonStyle}" />
                <Button
                    Margin="5"
                    Command="{Binding NavigateToAiGeneratorCommand}"
                    Content="🤖 Генератор завдань"
                    Style="{StaticResource MenuButtonStyle}" />
            </StackPanel>


            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{Binding IsNotTeacher, Converter={StaticResource BoolToVis}}">


            </StackPanel>

        </Grid>


        <Border
    Grid.Row="1"
    Grid.Column="1"
    Margin="0"
    Style="{StaticResource SpacePanelBorderStyle}">

            <ContentControl Margin="10" Content="{Binding CurrentTestingView}" />

        </Border>
    </Grid>
</UserControl>