<UserControl
    x:Class="SchoolJournal.Desktop.Features.Core.StudentParents.StudentParentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Text="Зв'язки Батьки-Учні" />

            <Button
                Margin="20,0,0,0"
                Padding="15,5"
                Background="#2ECC71"
                Command="{Binding OpenAddFormCommand}"
                Content="➕ Додати зв'язок"
                Foreground="White"
                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource UniversalVis}}" />

            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            BorderBrush="#DDD"
            BorderThickness="1"
            IsReadOnly="True"
            ItemsSource="{Binding ParentsForStudent}"
            Visibility="{Binding IsStudentContext, Converter={StaticResource UniversalVis}}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Parent.LastName}" Header="Прізвище" />
                <DataGridTextColumn Binding="{Binding Parent.FirstName}" Header="Ім'я" />
                <DataGridTextColumn Binding="{Binding Parent.Phone}" Header="Телефон" />
                <DataGridTextColumn Binding="{Binding Role}" Header="Ким доводиться (Роль)" />
                <DataGridTemplateColumn Width="100" Header="Дії">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Background="#E74C3C"
                                Command="{Binding DataContext.RemoveRelationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding StudentParentId}"
                                Content="Відв'язати"
                                Foreground="White" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            BorderBrush="#DDD"
            BorderThickness="1"
            IsReadOnly="True"
            ItemsSource="{Binding StudentsForParent}"
            Visibility="{Binding IsStudentContext, Converter={StaticResource UniversalVis}, ConverterParameter='Inverse'}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Student.LastName}" Header="Прізвище учня" />
                <DataGridTextColumn Binding="{Binding Student.FirstName}" Header="Ім'я учня" />
                <DataGridTextColumn Binding="{Binding Role}" Header="Роль батька" />
                <DataGridTemplateColumn Width="100" Header="Дії">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Background="#E74C3C"
                                Command="{Binding DataContext.RemoveRelationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding StudentParentId}"
                                Content="Відв'язати"
                                Foreground="White" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="105"
            Background="#80000000"
            Visibility="{Binding IsAddFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Новий зв'язок" />

                    <StackPanel Visibility="{Binding IsStudentContext, Converter={StaticResource UniversalVis}}">
                        <TextBlock FontWeight="SemiBold" Text="Оберіть профіль батька/матері:" />
                        <ComboBox
                            Margin="0,5,0,15"
                            Padding="5"
                            ItemsSource="{Binding AvailableParents}"
                            SelectedValue="{Binding SelectedAssignId}"
                            SelectedValuePath="ParentId">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding LastName}" /> <Run Text="{Binding FirstName}" />
                                        (<Run Text="{Binding Phone}" />
                                        )</TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsStudentContext, Converter={StaticResource UniversalVis}, ConverterParameter='Inverse'}">
                        <TextBlock FontWeight="SemiBold" Text="Оберіть учня:" />
                        <ComboBox
                            Margin="0,5,0,15"
                            Padding="5"
                            ItemsSource="{Binding AvailableStudents}"
                            SelectedValue="{Binding SelectedAssignId}"
                            SelectedValuePath="StudentId">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding LastName}" /> <Run Text="{Binding FirstName}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="Вкажіть роль (Мати, Батько, Опікун тощо):" />
                    <TextBox
                        Margin="0,5,0,20"
                        Padding="5"
                        Text="{Binding AssignRole, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseAddFormCommand}"
                            Content="Скасувати"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#2ECC71"
                            Command="{Binding SaveAssignCommand}"
                            Content="Прив'язати"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />
    </Grid>
</UserControl>