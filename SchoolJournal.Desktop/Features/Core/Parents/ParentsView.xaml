<UserControl
    x:Class="SchoolJournal.Desktop.Features.Core.Parents.ParentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,15"
            Orientation="Horizontal">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="Керування профілями батьків" />
            <Button
                Margin="20,0,0,0"
                Padding="15,5"
                Background="#2ECC71"
                Command="{Binding OpenCreateFormCommand}"
                Content="➕ Додати профіль"
                Foreground="White"
                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource UniversalVis}}" />
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            BorderBrush="#DDD"
            BorderThickness="1"
            IsReadOnly="True"
            ItemsSource="{Binding ActiveParents}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LastName}"
                    Header="Прізвище" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding FirstName}"
                    Header="Ім'я" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding MiddleName}"
                    Header="По батькові" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Phone}"
                    Header="Телефон" />
                <DataGridCheckBoxColumn
                    Width="80"
                    Binding="{Binding IsActive}"
                    Header="Активний" />
                <DataGridTemplateColumn Width="150" Header="Обліковий запис">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="Green"
                                    Text="✅ "
                                    Visibility="{Binding UserId, Converter={StaticResource UniversalVis}}" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="#2980B9"
                                    Text="{Binding Login}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn
                    Width="220"
                    Header="Дії"
                    Visibility="{Binding DataContext.IsAdminOrDirector, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource UniversalVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#F39C12"
                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="✏️"
                                    Foreground="White" />
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#1ABC9C"
                                    Command="{Binding DataContext.OpenAccountFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="🔗"
                                    Foreground="White"
                                    ToolTip="Обліковий запис" />
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#9B59B6"
                                    Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="Активність"
                                    Foreground="White" />
                                <Button
                                    Background="#E74C3C"
                                    Command="{Binding DataContext.DeleteParentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="Видалити"
                                    Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="{Binding IsFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Direction="270"
                        Opacity="0.25"
                        ShadowDepth="2" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="{Binding FormTitle}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Прізвище:" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        Text="{Binding FormLastName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Ім'я:" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        Text="{Binding FormFirstName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="По батькові:" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        Text="{Binding FormMiddleName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Телефон:" />
                    <TextBox
                        Margin="0,0,0,25"
                        Padding="5"
                        Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseFormCommand}"
                            Content="Скасувати"
                            FontWeight="Bold"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#3498DB"
                            Command="{Binding SaveFormCommand}"
                            Content="Зберегти"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="105"
            Background="#80000000"
            Visibility="{Binding IsAccountFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Реєстрація облікового запису" />
                    <TextBlock FontWeight="SemiBold" Text="Логін (для батьків):" />
                    <TextBox
                        Margin="0,5,0,15"
                        Padding="5"
                        Text="{Binding AccountLogin, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock FontWeight="SemiBold" Text="Пароль:" />
                    <TextBox
                        Margin="0,5,0,20"
                        Padding="5"
                        Text="{Binding AccountPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,0,0,15"
                        FontWeight="Bold"
                        Foreground="Red"
                        Text="{Binding ErrorMessage}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseAccountFormCommand}"
                            Content="Скасувати"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#1ABC9C"
                            Command="{Binding SaveAccountCommand}"
                            Content="Створити та прив'язати"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>