<UserControl
    x:Class="SchoolJournal.Desktop.Features.Core.Teachers.TeachersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,15"
            Orientation="Horizontal">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="Вчителі" />

            <Button
                Margin="20,0,0,0"
                Padding="15,5"
                Background="#2ECC71"
                Command="{Binding OpenCreateFormCommand}"
                Content="➕ Додати вчителя"
                Foreground="White" />

            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Teachers}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LastName}"
                    Header="Прізвище" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding FirstName}"
                    Header="Ім'я" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding PositionName}"
                    Header="Посада" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding QualificationName}"
                    Header="Кваліфікація" />

                <DataGridTemplateColumn Width="180" Header="Обліковий запис">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button
                                    x:Name="CreateBtn"
                                    Padding="8,4"
                                    Background="#9B59B6"
                                    Command="{Binding DataContext.OpenAssignFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="🔗 Створити акаунт"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Visibility="Collapsed" />

                                <StackPanel
                                    x:Name="LinkedPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="Green"
                                        Text="✅ " />
                                    <TextBlock
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="#333"
                                        Text="{Binding Login}" />

                                    <Button
                                        Padding="6,2"
                                        Background="#3498DB"
                                        Command="{Binding DataContext.OpenEditAccountFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="✏️"
                                        Foreground="White"
                                        ToolTip="Змінити логін або скинути пароль" />
                                </StackPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Login}" Value="{x:Null}">
                                    <Setter TargetName="CreateBtn" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="LinkedPanel" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Login}" Value="">
                                    <Setter TargetName="CreateBtn" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="LinkedPanel" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="{Binding IsFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Новий вчитель" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Прізвище:" />
                    <TextBox
                        Margin="0,5,0,15"
                        Padding="5"
                        Text="{Binding FormLastName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="По батькові:" />
                    <TextBox
                        Margin="0,5,0,15"
                        Padding="5"
                        Text="{Binding FormMiddleName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Дата народження:" />
                    <DatePicker Margin="0,5,0,15" SelectedDate="{Binding FormDateOfBirth, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Стать:" />
                    <StackPanel Margin="0,5,0,15" Orientation="Horizontal">
                        <RadioButton
                            Margin="0,0,15,0"
                            Content="Чоловіча"
                            IsChecked="{Binding IsMaleChecked, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton Content="Жіноча" IsChecked="{Binding IsFemaleChecked, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Ім'я:" />
                    <TextBox
                        Margin="0,5,0,15"
                        Padding="5"
                        Text="{Binding FormFirstName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Посада:" />
                    <ComboBox
                        Margin="0,5,0,15"
                        DisplayMemberPath="PositionName"
                        ItemsSource="{Binding Positions}"
                        SelectedValue="{Binding FormPositionId}"
                        SelectedValuePath="PositionId" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Кваліфікація:" />
                    <ComboBox
                        Margin="0,5,0,25"
                        DisplayMemberPath="QualificationName"
                        ItemsSource="{Binding Qualifications}"
                        SelectedValue="{Binding FormQualificationId}"
                        SelectedValuePath="QualificationId" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseFormCommand}"
                            Content="Скасувати"
                            FontWeight="Bold"
                            Foreground="White" />

                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#3498DB"
                            Command="{Binding SaveFormCommand}"
                            Content="Зберегти"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="101"
            Background="#80000000"
            Visibility="{Binding IsAssignFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Створити обліковий запис" />

                    <TextBlock
                        Margin="0,0,0,5"
                        Foreground="#555"
                        Text="Логін користувача:" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="8"
                        Text="{Binding AssignLoginInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        Foreground="#555"
                        Text="Пароль:" />
                    <TextBox
                        Margin="0,0,0,25"
                        Padding="8"
                        Text="{Binding AssignPasswordInput, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseAssignFormCommand}"
                            Content="Скасувати"
                            FontWeight="Bold"
                            Foreground="White" />

                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#9B59B6"
                            Command="{Binding SaveAssignFormCommand}"
                            Content="Створити"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="102"
            Background="#80000000"
            Visibility="{Binding IsEditAccountFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Редагування облікового запису" />

                    <TextBlock
                        Margin="0,0,0,5"
                        Foreground="#555"
                        Text="Логін користувача:" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="8"
                        Text="{Binding EditLoginInput, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,0,0,5"
                        Foreground="#555"
                        Text="Новий пароль (залиште порожнім, щоб не змінювати):"
                        TextWrapping="Wrap" />
                    <TextBox
                        Margin="0,0,0,25"
                        Padding="8"
                        Text="{Binding EditPasswordInput, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseEditAccountFormCommand}"
                            Content="Скасувати"
                            FontWeight="Bold"
                            Foreground="White" />

                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#3498DB"
                            Command="{Binding SaveEditAccountFormCommand}"
                            Content="Зберегти"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>