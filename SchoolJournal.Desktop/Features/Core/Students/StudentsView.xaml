<UserControl
    x:Class="SchoolJournal.Desktop.Features.Core.Students.StudentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SchoolJournal.Desktop.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UniversalVisibilityConverter x:Key="UniversalVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,15"
            Orientation="Horizontal">
            <TextBox
                Width="200"
                Padding="8,5"
                Tag="Пошук за прізвищем..."
                Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Margin="15,0,5,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Клас:" />
            <ComboBox
                Width="120"
                Padding="5"
                DisplayMemberPath="ClassName"
                ItemsSource="{Binding AvailableClasses}"
                SelectedValue="{Binding FilterClassId, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="ClassId" />

            <Button
                Margin="15,0"
                Padding="15,5"
                Command="{Binding SearchCommand}"
                Content="🔍 Пошук" />

            <Button
                Margin="10,0,0,0"
                Padding="15,5"
                Background="#2ECC71"
                Command="{Binding OpenCreateFormCommand}"
                Content="➕ Реєстрація учня"
                Foreground="White"
                Visibility="{Binding IsAdminOrDirector, Converter={StaticResource UniversalVis}}" />
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="Red"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Students}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LastName}"
                    Header="Прізвище" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding FirstName}"
                    Header="Ім'я" />

                <DataGridTemplateColumn Width="150" Header="Клас">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                Background="Transparent"
                                BorderThickness="0"
                                DisplayMemberPath="ClassName"
                                Foreground="Black"
                                IsHitTestVisible="False"
                                ItemsSource="{Binding DataContext.AvailableClasses, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedValue="{Binding ClassId, Mode=OneWay}"
                                SelectedValuePath="ClassId" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridCheckBoxColumn
                    Width="80"
                    Binding="{Binding IsActive}"
                    Header="Активний" />

                <DataGridTemplateColumn Width="150" Header="Обліковий запис">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="Green"
                                    Text="✅ "
                                    Visibility="{Binding UserId, Converter={StaticResource UniversalVis}}" />

                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="#2980B9"
                                    Text="{Binding Login}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="220" Header="Дії">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#F39C12"
                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="✏️"
                                    Foreground="White"
                                    ToolTip="Редагувати" />
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#3498DB"
                                    Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="🕒"
                                    Foreground="White"
                                    ToolTip="Історія" />
                                <Button
                                    Margin="0,0,5,0"
                                    Background="#9B59B6"
                                    Command="{Binding DataContext.OpenTransferFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="🔄"
                                    Foreground="White"
                                    ToolTip="Перевести" />
                                <Button
                                    Background="#1ABC9C"
                                    Command="{Binding DataContext.OpenAccountFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="🔗"
                                    Foreground="White"
                                    ToolTip="Обліковий запис" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#80000000"
            Visibility="{Binding IsFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="450"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{Binding FormTitle}" />
                    <TextBlock FontWeight="SemiBold" Text="Прізвище:" />
                    <TextBox Margin="0,5,0,15" Text="{Binding LastName}" />
                    <TextBlock FontWeight="SemiBold" Text="Ім'я:" />
                    <TextBox Margin="0,5,0,15" Text="{Binding FirstName}" />
                    <TextBlock FontWeight="SemiBold" Text="Медичні нотатки:" />
                    <TextBox
                        Height="80"
                        Margin="0,5,0,20"
                        AcceptsReturn="True"
                        Text="{Binding MedicalNotes}"
                        TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseFormCommand}"
                            Content="Скасувати"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#3498DB"
                            Command="{Binding SaveCommand}"
                            Content="Зберегти"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="105"
            Background="#80000000"
            Visibility="{Binding IsAccountFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Реєстрація облікового запису" />
                    <TextBlock FontWeight="SemiBold" Text="Логін користувача (для учня):" />
                    <TextBox
                        Margin="0,5,0,15"
                        Padding="5"
                        Text="{Binding AccountLogin, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock FontWeight="SemiBold" Text="Пароль:" />
                    <TextBox
                        Margin="0,5,0,20"
                        Padding="5"
                        Text="{Binding AccountPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,0,0,15"
                        FontWeight="Bold"
                        Foreground="Red"
                        Text="{Binding ErrorMessage}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource UniversalVis}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseAccountFormCommand}"
                            Content="Скасувати"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#1ABC9C"
                            Command="{Binding SaveAccountCommand}"
                            Content="Створити та прив'язати"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="106"
            Background="#80000000"
            Visibility="{Binding IsTransferFormOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="400"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#8E44AD"
                        Text="🔄 Переведення до іншого класу" />
                    <TextBlock FontWeight="SemiBold" Text="Оберіть новий клас:" />
                    <ComboBox
                        Margin="0,5,0,25"
                        Padding="5"
                        DisplayMemberPath="ClassName"
                        ItemsSource="{Binding AvailableClasses}"
                        SelectedValue="{Binding TransferClassId, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="ClassId" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="10"
                            Background="#95A5A6"
                            Command="{Binding CloseTransferFormCommand}"
                            Content="Скасувати"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Padding="10"
                            Background="#9B59B6"
                            Command="{Binding SaveTransferCommand}"
                            Content="Перевести"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            Panel.ZIndex="107"
            Background="#80000000"
            Visibility="{Binding IsHistoryOpen, Converter={StaticResource UniversalVis}}">
            <Border
                Width="700"
                Padding="25"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#2980B9"
                        Text="🕒 Історія змін картки учня" />
                    <DataGrid
                        MaxHeight="350"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding HistoryRecords}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ValidFrom, StringFormat='dd.MM.yyyy HH:mm'}" Header="Дата зміни" />
                            <DataGridTextColumn Binding="{Binding LastName}" Header="Прізвище" />
                            <DataGridTextColumn Binding="{Binding FirstName}" Header="Ім'я" />
                            <DataGridCheckBoxColumn Binding="{Binding IsActive}" Header="Активний" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button
                        Margin="0,20,0,0"
                        Padding="10,8"
                        HorizontalAlignment="Right"
                        Background="#95A5A6"
                        Command="{Binding CloseHistoryCommand}"
                        Content="Закрити історію"
                        Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>

        <ProgressBar
            Grid.Row="1"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource UniversalVis}}" />
    </Grid>
</UserControl>